{
  "name": "claude-agent-sdk-lesson25-mcp-auth-errors",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Teach MCP authentication through env, headers and OAuth handoff; detect failures and reconnect with actual SDK status controls",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "dev": "npm start",
    "agent": "npm run sample:env",
    "build:client": "tsc -p tsconfig.client.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx --test src/agent.test.ts src/startup.test.ts",
    "sample": "tsx src/sample.ts",
    "sample:env": "tsx --env-file-if-exists=.env src/sample.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.310",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@modelcontextprotocol/server-filesystem": "2.0.1",
    "dompurify": "3.4.17",
    "marked": "18.1.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
